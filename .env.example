# ─── service ────────────────────────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Explicit origins. A wildcard with credentials is rejected by browsers
# and an open control-plane API is not a sensible default.
CORS_ORIGINS=["http://localhost:8000"]

# Required for anything that changes signal state. Leave unset and the
# operator endpoints refuse rather than running unauthenticated.
OPERATOR_TOKEN=

# ─── storage ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/traffic.db
MODEL_DIR=./data/models
LOG_INTERVAL=10
LIVE_HISTORY=720

# ─── control loop ───────────────────────────────────────────────────
SENSOR_MODE=simulation          # simulation | camera | iot
CONTROL_MODE=adaptive           # adaptive | fixed_time
TICK_SECONDS=1.0
REALTIME_FACTOR=1.0             # below 1.0 runs the demo faster than real time

# ─── timing plan (seconds) ──────────────────────────────────────────
MIN_GREEN=10
MAX_GREEN=60
YELLOW_CHANGE=3.5
RED_CLEARANCE=2.0
PED_WALK=7
PED_CLEARANCE=11
MAX_RED=120
GAP_THRESHOLD=3
HYSTERESIS=1.15
PREEMPT_MAX_HOLD=45
PREEMPT_BUDGET=90
PREEMPT_WINDOW=600
PED_MAX_WAIT=90

# Low-sun glare, applied only on the approaches facing the sun.
GLARE_EXTRA_CLEARANCE=1.2
GLARE_DISCHARGE_FACTOR=0.92

# ─── forecasting ────────────────────────────────────────────────────
FORECAST_ENABLED=true
FORECAST_HORIZON=1
TRAIN_INTERVAL_SECONDS=900

# ─── site and UV / ambient-light sensor ─────────────────────────────
# Solar geometry needs the site position, and the simulated clock is local
# time, so its UTC offset has to be stated rather than assumed.
SITE_LATITUDE=17.385
SITE_LONGITUDE=78.4867
SITE_ALTITUDE_M=0
SITE_UTC_OFFSET_HOURS=5.5

GLARE_ELEVATION_MAX=15          # degrees; sun above this is not glare
GLARE_BEAM_FRACTION=0.55        # measured UV / clear-sky UV for a direct beam
GLARE_LUX_MIN=1200              # visible light needed to dazzle
GLARE_AZIMUTH_TOLERANCE=35      # degrees off a driver's heading
UV_MAX_AGE=120                  # pushed readings older than this are stale

# ─── camera backend (only read when SENSOR_MODE=camera) ─────────────
CAMERA_SOURCE=0
CAMERA_WEIGHTS=yolov8n.pt
# Per-approach stop-line polygon, image-to-road homography and posted
# limit. The backend refuses to start without it; see
# docs/camera-calibration.md and data/camera.example.json.
CAMERA_CALIBRATION=
CAMERA_GLARE_CONFIDENCE_FLOOR=0.45

# ─── iot backend (only read when SENSOR_MODE=iot) ───────────────────
MQTT_HOST=
MQTT_PORT=1883
MQTT_PREFIX=traffic/j1
MQTT_USERNAME=
MQTT_PASSWORD=
IOT_DETECTOR_MAX_AGE=5          # seconds of silence before recall
IOT_EMERGENCY_TTL=6             # a beacon that stops means the vehicle passed
